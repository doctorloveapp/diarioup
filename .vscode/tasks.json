{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DiarioUp: APK release per sideload",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tool\\build_sideload_release.ps1",
        "-Environment",
        "demo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$dart-build",
      "group": "build"
    }
  ]
}
